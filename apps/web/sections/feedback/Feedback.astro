---
import { anchorAttrs } from '../../../lib/link-attrs'
import type { Section } from '../definitions'
import Typography from '../../atoms/Typography.astro'
import SectionHeader from '../../molecules/SectionHeader.astro'
import SectionShell from '../../molecules/SectionShell.astro'

interface Props {
  section: Extract<Section, { type: 'feedback' }>
  index: number
  motion?: boolean
}

const { section, index, motion = true } = Astro.props
const props = section.props
const field = (path: string) => `sections.${index}.props.${path}`
const reveal = section.motion ?? motion

/** 24px stroke icons. */
const icons = {
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
}
const svg = (paths: string) =>
  `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`

/** The primary card keeps the inverse palette whatever tone the section has. */
const card = {
  primary:
    'bg-[var(--t-inverse-bg)] text-[var(--t-inverse-fg)] hover:bg-[var(--t-inverse-surface)] hover:text-[var(--t-inverse-fg)]',
  secondary: 'bg-surface text-fg ring-line hover:shadow-[inset_0_0_0_1px_color-mix(in_oklch,var(--fg)_28%,transparent)] hover:text-fg',
}
const tile = { primary: 'bg-accent text-on', secondary: 'bg-bg text-fg' }
const sub = { primary: 'text-[var(--t-inverse-muted)]', secondary: 'text-muted' }

const label = 'font-mono text-[0.6875rem] tracking-[0.08em] uppercase'
const textLink = 'font-medium text-link underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-link'
const dot = 'size-5 shrink-0 rounded-full'
const line = 'my-1.5 w-0.5 flex-1'
const solid = 'bg-line'
const dashed = 'bg-[linear-gradient(color-mix(in_oklch,var(--fg)_18%,transparent)_50%,transparent_50%)] bg-[length:2px_8px]'
const last = props.roadmap.length - 1
---

<SectionShell id={section.id} anchor={section.anchor} type={section.type} variant={section.variant} tone={section.tone} motion={reveal}>
  <div class="section-container">
    <div class="mx-auto grid max-w-[76rem] grid-cols-[repeat(auto-fit,minmax(min(100%,24rem),1fr))] items-start gap-[clamp(2.5rem,5cqi,5rem)]">
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} size="h2-md" field={field} headingClass="max-w-[14ch]" />
          {props.body && <Typography as="p" size="body" color="muted" class="max-w-[30rem] text-[1.0625rem] leading-[1.55]" data-field={field('body')} markdown={props.body} />}
        </div>

        <div class="flex flex-col gap-3">
          {props.channels.map((channel, channelIndex) => {
            const at = (path: string) => field(`channels.${channelIndex}.${path}`)
            return (
              <a
                {...anchorAttrs(channel)}
                class:list={[
                  'grid grid-cols-[2.75rem_minmax(0,1fr)_auto] items-center gap-4 rounded-card px-5 py-[1.125rem] transition-[background-color,box-shadow] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-link',
                  card[channel.variant],
                ]}
              >
                <span class:list={['grid size-11 place-items-center rounded-[0.875rem]', tile[channel.variant]]} set:html={svg(icons[channel.icon])} />
                <span class="flex min-w-0 flex-col gap-0.5">
                  <strong class="text-[1.0625rem] font-semibold tracking-[-0.015em]" data-field={at('title')}>{channel.title}</strong>
                  {channel.description && <span class:list={['text-[0.875rem]', sub[channel.variant]]} data-field={at('description')}>{channel.description}</span>}
                </span>
                <span aria-hidden="true" class="text-[1.25rem]">→</span>
              </a>
            )
          })}
          {
            props.bugLink && (
              <a {...anchorAttrs(props.bugLink)} class:list={[textLink, 'mt-1 self-start text-[0.9375rem]']}>
                <span data-field={field('bugLink.label')}>{props.bugLink.label}</span> <span aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
      </div>

      <div class="overflow-hidden rounded-card-lg bg-surface text-fg shadow-[inset_0_0_0_1px_var(--line),0_40px_60px_-40px_oklch(0.2_0.02_255/0.3)]">
        {
          (props.roadmapTitle || props.roadmapLabel) && (
            <div class="flex items-center justify-between gap-3 border-b border-line px-6 py-4">
              {props.roadmapTitle && <h3 class="text-[1rem] font-semibold tracking-[-0.015em]" data-field={field('roadmapTitle')}>{props.roadmapTitle}</h3>}
              {props.roadmapLabel && <span class="ml-auto font-mono text-[0.75rem] text-muted" data-field={field('roadmapLabel')}>{props.roadmapLabel}</span>}
            </div>
          )
        }

        <ol class="flex flex-col px-6 pt-7 pb-2">
          {props.roadmap.map((item, itemIndex) => {
            const at = (path: string) => field(`roadmap.${itemIndex}.${path}`)
            const active = itemIndex === 0
            const isLast = itemIndex === last
            // The last milestone leads to the open "your idea" step, further out: dashed. Without it, no line.
            const connector = isLast ? (props.pitch ? dashed : undefined) : solid
            return (
              <li class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-5">
                <div class="flex flex-col items-center" aria-hidden="true">
                  <span
                    class:list={[
                      dot,
                      active
                        ? 'bg-accent shadow-[0_0_0_5px_color-mix(in_oklch,var(--accent)_25%,transparent)]'
                        : 'bg-surface shadow-[inset_0_0_0_2px_color-mix(in_oklch,var(--fg)_50%,transparent)]',
                    ]}
                  />
                  {connector && <span class:list={[line, connector]} />}
                </div>
                <div class="flex flex-col gap-2 pb-8">
                  <span class:list={[label, active ? 'text-link' : 'text-muted']} data-field={at('status')}>{item.status}</span>
                  <h4 class="text-[1.25rem] font-semibold tracking-[-0.02em]" data-field={at('title')}>{item.title}</h4>
                  {item.body && <Typography as="p" size="body" color="muted" class="leading-[1.5]" data-field={at('body')} markdown={item.body} />}
                  {
                    item.parts && item.parts.length > 0 && (
                      <div class="mt-1.5 grid grid-cols-[repeat(auto-fit,minmax(min(100%,11rem),1fr))] gap-2">
                        {item.parts.map((part, partIndex) => (
                          <div class="flex flex-col gap-1 rounded-[0.875rem] bg-[color-mix(in_oklch,var(--fg)_4%,var(--surface))] px-3.5 py-3">
                            <span class="font-mono text-[0.8125rem] font-medium" data-field={at(`parts.${partIndex}.title`)}>{part.title}</span>
                            {part.body && <span class="text-[0.8125rem] leading-[1.4] text-muted" data-field={at(`parts.${partIndex}.body`)}>{part.body}</span>}
                          </div>
                        ))}
                      </div>
                    )
                  }
                </div>
              </li>
            )
          })}
          {
            props.pitch && (
              <li class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-5">
                <div class="flex justify-center" aria-hidden="true">
                  <span class:list={[dot, 'grid place-items-center text-[0.875rem] leading-none text-muted shadow-[inset_0_0_0_2px_color-mix(in_oklch,var(--fg)_25%,transparent)]']}>+</span>
                </div>
                <div class="flex flex-col gap-1.5 pb-6">
                  {props.pitchStatus && <span class:list={[label, 'text-muted']} data-field={field('pitchStatus')}>{props.pitchStatus}</span>}
                  <a {...anchorAttrs(props.pitch)} class:list={[textLink, 'self-start text-[1.25rem] font-semibold tracking-[-0.02em]']}>
                    <span data-field={field('pitch.label')}>{props.pitch.label}</span> <span aria-hidden="true">→</span>
                  </a>
                </div>
              </li>
            )
          }
        </ol>
      </div>
    </div>
  </div>
</SectionShell>
