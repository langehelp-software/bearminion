{
  "name": "@bearminion/web",
  "version": "0.0.0",
  "private": true,
  "description": "bearminion.com: the default template's code with this site's own content, edited with BearMinion.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-template.mjs",
    "dev": "node scripts/sync-template.mjs && astro dev",
    "build": "pnpm --filter bearminion build && node scripts/sync-template.mjs && astro build",
    "preview": "astro preview",
    "typecheck": "node scripts/sync-template.mjs && astro check",
    "check-styles": "node scripts/check-styles.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.12",
    "astro": "^7.4.2",
    "bearminion": "^1.10.1",
    "class-variance-authority": "^0.7.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.19.0",
    "bearminion-site": "workspace:*",
    "typescript": "~5.9.3"
  }
}
