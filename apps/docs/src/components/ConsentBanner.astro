---
// The template's banner (templates/default/src/components/organisms/ConsentBanner.astro) in Starlight's styles.
// Same data attributes, so the template's script runs it unchanged.
import { consentText as copy, sharedDomain } from '../consent'
---

{/* Hidden until the script finds no stored choice, so a returning visitor never sees it flash. */}
<div
  class="bm-consent"
  data-consent-banner
  data-consent-domain={sharedDomain}
  role="region"
  aria-label={copy.title}
  tabindex="-1"
  hidden
>
  <p class="bm-consent-title">{copy.title}</p>
  <p class="bm-consent-body">
    {copy.body}
    {
      copy.policyHref && (
        <>
          {' '}
          <a href={copy.policyHref}>{copy.policyLabel}</a>
        </>
      )
    }
  </p>
  {/* Same look and size on both: refusing must be as easy as accepting. */}
  <div class="bm-consent-actions">
    <button type="button" data-consent-accept>{copy.accept}</button>
    <button type="button" data-consent-reject>{copy.reject}</button>
  </div>
</div>

<script>
  import { initConsent } from 'bearminion-site/src/lib/consent-client'

  const banner = document.querySelector<HTMLElement>('[data-consent-banner]')
  if (banner) {
    // The footer sits in Starlight's main pane, which isolates its own stacking context, so no z-index there can lift
    // the banner over the sidebar. Moved to <body>, it stacks against the page itself.
    document.body.append(banner)
    initConsent(banner)
  }
</script>

<style>
  .bm-consent:not([hidden]) {
    position: fixed;
    inset-inline: 1rem;
    bottom: 1rem;
    z-index: 30;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 26rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 1rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    box-shadow: var(--sl-shadow-lg);
    outline: none;
  }
  @media (min-width: 40rem) {
    .bm-consent:not([hidden]) {
      inset-inline-start: 1.5rem;
      bottom: 1.5rem;
    }
  }
  .bm-consent p {
    margin: 0;
  }
  .bm-consent-title {
    font-family: var(--bm-font-display);
    font-size: var(--sl-text-lg);
    font-weight: 700;
  }
  .bm-consent-body {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .bm-consent-body a {
    color: inherit;
    text-underline-offset: 0.25em;
  }
  .bm-consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .bm-consent-actions button {
    padding: 0.4rem 1rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .bm-consent-actions button:hover {
    border-color: var(--sl-color-accent);
  }
  .bm-consent-actions button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
