---
import { cn } from '../../lib/cn'

interface Props {
  /** The shell command, such as `npm create bearminion@latest`. */
  command: string
  class?: string
  'data-field'?: string
}

const { command, class: className, 'data-field': dataField } = Astro.props
---

<div
  class={cn(
    'inline-flex max-w-full items-center gap-3 rounded-full border border-line bg-surface py-1.5 ps-4 pe-1.5 font-mono text-[0.8125rem] text-fg',
    className,
  )}
  data-command-line
>
  <span class="text-muted select-none" aria-hidden="true">$</span>
  <code class="min-w-0 truncate" data-command data-field={dataField}>{command}</code>
  <button
    type="button"
    class="shrink-0 rounded-full bg-fg px-3 py-1.5 text-[0.75rem] font-medium text-bg transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    aria-label="Copy command"
    data-copy-command
  >
    <span data-copy-label>Copy</span>
  </button>
  <span class="sr-only" role="status" data-copy-status></span>
</div>

<script>
  /** Copies the command as it is on the page now, so an edit in the editor is what gets copied. */
  function bindCommandLines() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-command]')) {
      if (button.dataset.bound === 'true') continue
      button.dataset.bound = 'true'
      const line = button.closest('[data-command-line]')
      const label = button.querySelector('[data-copy-label]')
      const status = line?.querySelector('[data-copy-status]')
      button.addEventListener('click', async () => {
        const code = line?.querySelector('[data-command]')
        const command = code?.textContent?.trim() ?? ''
        if (!command) return
        try {
          await navigator.clipboard.writeText(command)
        } catch {
          // No clipboard access (an insecure origin, or the permission was refused): select the text instead.
          if (code) window.getSelection()?.selectAllChildren(code)
          return
        }
        if (label) label.textContent = 'Copied'
        if (status) status.textContent = 'Command copied'
        window.setTimeout(() => {
          if (label) label.textContent = 'Copy'
          if (status) status.textContent = ''
        }, 1600)
      })
    }
  }
  bindCommandLines()
  document.addEventListener('bearminion:preview', bindCommandLines)
</script>
