---
import type { Section } from './definitions'
import { sectionComponents } from './components.gen'

interface Props {
  sections: Section[]
  /** Site-wide motion. A section's own `motion` overrides this. */
  motion?: boolean
}

/** What every section component takes. Each one narrows `section` to its own type. */
type SectionComponent = (props: { section: Section; index: number; motion?: boolean }) => unknown

const { sections, motion = true } = Astro.props
---

{
  sections.map((section, index) => {
    const Component = sectionComponents[section.type] as unknown as SectionComponent
    return <Component section={section} index={index} motion={motion} />
  })
}
