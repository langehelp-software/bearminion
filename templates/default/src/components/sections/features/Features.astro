---
import type { Section } from '../definitions'
import Button from '../../atoms/Button.astro'
import { buttonLinkProps, buttonVariant } from '../../../lib/link-attrs'
import Typography from '../../atoms/Typography.astro'
import MediaFrame from '../../molecules/MediaFrame.astro'
import SectionHeader from '../../molecules/SectionHeader.astro'
import SectionShell from '../../molecules/SectionShell.astro'

interface Props {
  section: Extract<Section, { type: 'features' }>
  index: number
  motion?: boolean
}

const { section, index, motion = true } = Astro.props
const props = section.props
const field = (path: string) => `sections.${index}.props.${path}`
const reveal = section.motion ?? motion
---

<SectionShell id={section.id} anchor={section.anchor} type={section.type} variant={section.variant} tone={section.tone} motion={reveal}>
  {
    section.variant === 'cards' && (
      <div class="section-container">
        {
          (props.eyebrow || props.heading || props.intro) && (
            <div class="grid items-end gap-8 @min-[760px]:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
              <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} field={field} />
              {props.intro && <Typography as="p" size="lead" color="muted" data-field={field('intro')} markdown={props.intro} />}
            </div>
          )
        }
        <ul class="mt-12 grid grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))] gap-4">
          {props.items.map((item, itemIndex) => (
            <li class="flex flex-col gap-4 rounded-card-lg bg-surface p-6 ring-line transition duration-200 hover:-translate-y-1 hover:shadow-[0_24px_40px_-28px_oklch(0.2_0.02_255/0.4)]">
              {!item.image?.hidden && (
<MediaFrame
                src={item.image?.src}
                alt={item.image?.alt ?? item.title}
                aspectClass="aspect-[4/3]"
                fit={item.image?.fit} position={item.image?.position} data-field={field(`items.${itemIndex}.image.alt`)}
              />
)}
              <p class="font-mono text-[0.6875rem] tracking-[0.08em] text-muted">{String(itemIndex + 1).padStart(2, '0')}</p>
              <Typography as="h3" size="h3" data-field={field(`items.${itemIndex}.title`)}>
                {item.title}
              </Typography>
              {item.description && <Typography as="p" size="body" color="muted" data-field={field(`items.${itemIndex}.description`)} markdown={item.description} />}
            </li>
          ))}
        </ul>
      </div>
    )
  }
  {
    section.variant === 'list' && (
      <div class="section-container grid items-start gap-12 @min-[880px]:grid-cols-[minmax(min(100%,22rem),1fr)_minmax(0,1.2fr)]">
        {
          (props.eyebrow || props.heading || props.intro || props.link) && (
            <div class="flex flex-col items-start gap-6 @min-[880px]:sticky @min-[880px]:top-28">
              <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} intro={props.intro} field={field} />
              {props.link && (
                <Button {...buttonLinkProps(props.link)} variant={buttonVariant(props.link, 'text')} arrow data-field={field('link.label')}>
                  {props.link.label}
                </Button>
              )}
            </div>
          )
        }
        <ol>
          {props.items.map((item, itemIndex) => (
            <li class="grid grid-cols-[auto_1fr] gap-6 border-t border-[var(--line)] py-6">
              <span class="font-mono text-[0.75rem] tracking-[0.08em] text-muted">{String(itemIndex + 1).padStart(2, '0')}</span>
              <div>
                <Typography as="h3" size="h3" data-field={field(`items.${itemIndex}.title`)}>
                  {item.title}
                </Typography>
                {item.description && <Typography as="p" size="body" color="muted" class="mt-2" data-field={field(`items.${itemIndex}.description`)} markdown={item.description} />}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )
  }
  {
    section.variant === 'bento' && (
      <div class="section-container">
        <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} intro={props.intro} align="center" field={field} class="mx-auto max-w-3xl" />
        <ul class="mt-12 grid grid-cols-1 gap-4 @min-[620px]:grid-cols-2 @min-[960px]:grid-cols-3">
          {props.items.map((item, itemIndex) => (
            <li
              class:list={[
                'flex flex-col gap-4 rounded-card-lg bg-surface p-6 ring-line',
                itemIndex === 0 && '@min-[620px]:col-span-2 @min-[960px]:row-span-2',
                itemIndex === 3 && '@min-[620px]:col-span-2 @min-[960px]:col-span-3 @min-[960px]:grid @min-[960px]:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] @min-[960px]:items-end @min-[960px]:gap-8',
              ]}
            >
              {!item.image?.hidden && (
<MediaFrame
                src={item.image?.src}
                alt={item.image?.alt ?? item.title}
                aspectClass={itemIndex === 0 ? 'aspect-[4/3] min-h-48 flex-1' : 'aspect-[4/3]'}
                fit={item.image?.fit} position={item.image?.position} data-field={field(`items.${itemIndex}.image.alt`)}
              />
)}
              <div>
                <p class="font-mono text-[0.6875rem] tracking-[0.08em] text-muted">{String(itemIndex + 1).padStart(2, '0')}</p>
                <Typography as="h3" size="h3" class="mt-3" data-field={field(`items.${itemIndex}.title`)}>
                  {item.title}
                </Typography>
                {item.description && <Typography as="p" size="body" color="muted" class="mt-2" data-field={field(`items.${itemIndex}.description`)} markdown={item.description} />}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</SectionShell>
