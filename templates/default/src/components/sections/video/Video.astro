---
import type { Section } from '../definitions'
import Typography from '../../atoms/Typography.astro'
import SectionHeader from '../../molecules/SectionHeader.astro'
import SectionShell from '../../molecules/SectionShell.astro'
import VideoFrame from './VideoFrame.astro'

interface Props {
  section: Extract<Section, { type: 'video' }>
  index: number
  motion?: boolean
}

const { section, index, motion = true } = Astro.props
const props = section.props
const field = (path: string) => `sections.${index}.props.${path}`
const reveal = section.motion ?? motion
const loop = props.playback === 'loop'
const hasHeader = Boolean(props.eyebrow || props.heading || props.intro)
// The empty frame is an editor hint. A built site leaves it out rather than show visitors an instruction.
const showFrame = props.video !== 'placeholder' || import.meta.env.DEV
---

<SectionShell id={section.id} anchor={section.anchor} type={section.type} variant={section.variant} tone={section.tone} motion={reveal}>
  {
    section.variant === 'framed' && (
      <div class="section-container flex flex-col items-center gap-10">
        {hasHeader && (
          <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} intro={props.intro} align="center" field={field} />
        )}
        {showFrame && (<figure class="w-full max-w-5xl">
          <VideoFrame src={props.video} poster={props.poster} label={props.label} loop={loop} class="shadow-[0_30px_80px_-40px_rgb(0_0_0/0.45)]" />
          {props.caption && (
            <Typography as="p" size="sm" color="muted" class="mt-3 text-center" data-field={field('caption')}>
              {props.caption}
            </Typography>
          )}
        </figure>)}
      </div>
    )
  }
  {
    section.variant === 'wide' && (
      <div class="flex flex-col gap-10">
        {hasHeader && (
          <div class="section-container">
            <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} intro={props.intro} field={field} />
          </div>
        )}
        {showFrame && (<figure>
          <VideoFrame src={props.video} poster={props.poster} label={props.label} loop={loop} roundedClass="rounded-none" />
          {props.caption && (
            <div class="section-container">
              <Typography as="p" size="sm" color="muted" class="mt-3" data-field={field('caption')}>
                {props.caption}
              </Typography>
            </div>
          )}
        </figure>)}
      </div>
    )
  }
  {
    section.variant === 'split' && (
      <div class="section-container grid items-center gap-12 @min-[860px]:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        {hasHeader && <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} intro={props.intro} field={field} />}
        {showFrame && (<figure class:list={[!hasHeader && '@min-[860px]:col-span-2']}>
          <VideoFrame src={props.video} poster={props.poster} label={props.label} loop={loop} />
          {props.caption && (
            <Typography as="p" size="sm" color="muted" class="mt-3" data-field={field('caption')}>
              {props.caption}
            </Typography>
          )}
        </figure>)}
      </div>
    )
  }
</SectionShell>
