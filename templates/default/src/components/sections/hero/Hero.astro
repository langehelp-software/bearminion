---
import type { Section } from '../definitions'
import Button from '../../atoms/Button.astro'
import { buttonLinkProps, buttonVariant } from '../../../lib/link-attrs'
import Emphasis from '../../atoms/Emphasis.astro'
import Typography from '../../atoms/Typography.astro'
import CommandLine from '../../molecules/CommandLine.astro'
import HeroBadge from './HeroBadge.astro'
import MediaFrame from '../../molecules/MediaFrame.astro'
import Pill from '../../molecules/Pill.astro'
import SectionShell from '../../molecules/SectionShell.astro'

interface Props {
  section: Extract<Section, { type: 'hero' }>
  index: number
  motion?: boolean
}

const { section, index, motion = true } = Astro.props
const props = section.props
const field = (path: string) => `sections.${index}.props.${path}`
const reveal = section.motion ?? motion
const primary = props.button ? props.primary : undefined
const command = props.code !== 'off' ? props.command : undefined
// `action` puts the command in the button row, in the secondary button's place.
const action = props.code === 'action' ? command : undefined
const secondary = action ? undefined : props.secondary
const below = props.code === 'chip' || props.code === 'terminal' ? command : undefined
const belowVariant = props.code === 'terminal' ? 'terminal' : 'chip'
const hasActions = Boolean(primary || secondary || action)
const media = props.image ?? { src: 'placeholder', alt: 'hero visual — editor beside live page preview' }
---

<SectionShell id={section.id} anchor={section.anchor} type={section.type} variant={section.variant} tone={section.tone} motion={reveal}>
  {
    // Centred on the heading and faded out well before the edges, so it never meets the section above in a seam.
    props.glow && (
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 70% 60% at 50% 36%, color-mix(in oklch, var(--accent) var(--hero-glow, 20%), transparent), transparent 72%)"
        aria-hidden="true"
        data-hero-glow
      />
    )
  }
  {
    section.variant === 'split' && (
      <div class="relative mx-auto grid max-w-[80rem] grid-cols-[repeat(auto-fit,minmax(min(100%,26rem),1fr))] items-center gap-[clamp(2.5rem,5cqi,5rem)] px-[clamp(1.25rem,4cqi,3rem)] py-[clamp(3.5rem,2rem+5cqi,7rem)]">
        <div class="flex flex-col items-start gap-6">
          {props.badge ? <HeroBadge badge={props.badge} field={field} /> : props.eyebrow && <Pill data-field={field('eyebrow')}>{props.eyebrow}</Pill>}
          {
            props.heading && (
              <Typography as="h1" size="display">
                <Emphasis heading={props.heading} marks={props.marks} data-field={field('heading')} />
              </Typography>
            )
          }
          {props.sub && <Typography as="p" size="lead" color="muted" data-field={field('sub')} class="max-w-[34rem]" markdown={props.sub} />}
          {
            hasActions && (
              <div class="mt-2 flex flex-wrap gap-2.5">
                {primary && (
                  <Button {...buttonLinkProps(primary)} variant={buttonVariant(primary, 'primary')} arrow data-field={field('primary.label')}>
                    {primary.label}
                  </Button>
                )}
                {secondary && (
                  <Button {...buttonLinkProps(secondary)} variant={buttonVariant(secondary, 'secondary')} data-field={field('secondary.label')}>
                    {secondary.label}
                  </Button>
                )}
                {action && <CommandLine command={action} variant="action" data-field={field('command')} />}
              </div>
            )
          }
          {below && <CommandLine command={below} variant={belowVariant} data-field={field('command')} />}
        </div>
        {!props.image?.hidden && (
<MediaFrame src={media.src} alt={media.alt} aspectClass="aspect-[4/3.4]" fit={media?.fit} position={media?.position} data-field={field('image.alt')} priority />
)}
      </div>
    )
  }
  {
    section.variant === 'centered' && (
      <div class="relative mx-auto flex max-w-[80rem] flex-col items-center gap-6 px-[clamp(1.25rem,4cqi,3rem)] pt-[clamp(4rem,2rem+6cqi,8rem)] pb-[clamp(5rem,3rem+7cqi,10rem)] text-center">
        {props.badge ? <HeroBadge badge={props.badge} field={field} /> : props.eyebrow && <Pill data-field={field('eyebrow')}>{props.eyebrow}</Pill>}
        {
          props.heading && (
            <Typography as="h1" size="display-center">
              <Emphasis heading={props.heading} marks={props.marks} data-field={field('heading')} />
            </Typography>
          )
        }
        {props.sub && <Typography as="p" size="lead" color="muted" data-field={field('sub')} class="max-w-[38rem]" markdown={props.sub} />}
        {
          hasActions && (
            <div class="mt-2 flex flex-wrap justify-center gap-2.5">
              {primary && (
                <Button {...buttonLinkProps(primary)} variant={buttonVariant(primary, 'primary')} arrow data-field={field('primary.label')}>
                  {primary.label}
                </Button>
              )}
              {secondary && (
                <Button {...buttonLinkProps(secondary)} variant={buttonVariant(secondary, 'secondary')} data-field={field('secondary.label')}>
                  {secondary.label}
                </Button>
              )}
              {action && <CommandLine command={action} variant="action" data-field={field('command')} />}
            </div>
          )
        }
        {below && <CommandLine command={below} variant={belowVariant} data-field={field('command')} class="mt-1" />}
        {!props.image?.hidden && (
<MediaFrame
          src={media.src}
          alt={media.alt}
          aspectClass="mt-[clamp(2rem,4cqi,4rem)] aspect-video min-h-52 w-full"
          roundedClass="rounded-[clamp(1rem,2cqi,1.75rem)]"
          class="text-left shadow-[0_40px_80px_-48px_oklch(0.2_0.02_255/0.45)]"
          fit={media?.fit} position={media?.position} data-field={field('image.alt')}
          priority
        />
)}
      </div>
    )
  }
  {
    section.variant === 'editorial' && (
      <div class="relative mx-auto max-w-[80rem] px-[clamp(1.25rem,4cqi,3rem)] pt-[clamp(3.5rem,2rem+5cqi,7rem)] pb-[clamp(2.5rem,2rem+3cqi,5rem)]">
        {
          props.eyebrow && (
            <Typography as="p" size="eyebrow" color="muted" data-field={field('eyebrow')}>
              {props.eyebrow}
            </Typography>
          )
        }
        {
          props.heading && (
            <Typography as="h1" size="display-editorial" class="mt-5">
              <Emphasis heading={props.heading} marks={props.marks} data-field={field('heading')} />
            </Typography>
          )
        }
        {
          (props.sub || hasActions || below) && (
            <div class="mt-[clamp(2rem,4cqi,3.5rem)] flex flex-wrap items-end justify-between gap-x-12 gap-y-6 border-t border-[var(--line)] pt-6">
              {props.sub && <Typography as="p" size="lead" color="muted" data-field={field('sub')} class="max-w-xl flex-[1_1_22rem]" markdown={props.sub} />}
              {(hasActions || below) && (
                <div class="flex flex-col items-start gap-4">
                  {hasActions && (
                    <div class="flex flex-wrap items-center gap-2.5">
                      {action && <CommandLine command={action} variant="action" data-field={field('command')} />}
                      {secondary && (
                        <Button {...buttonLinkProps(secondary)} variant={buttonVariant(secondary, 'secondary')} data-field={field('secondary.label')}>
                          {secondary.label}
                        </Button>
                      )}
                      {primary && (
                        <Button {...buttonLinkProps(primary)} variant={buttonVariant(primary, 'primary')} arrow data-field={field('primary.label')}>
                          {primary.label}
                        </Button>
                      )}
                    </div>
                  )}
                  {below && <CommandLine command={below} variant={belowVariant} data-field={field('command')} />}
                </div>
              )}
            </div>
          )
        }
        {!props.image?.hidden && (
<MediaFrame
          src={media.src}
          alt={media.alt}
          aspectClass="mt-[clamp(2rem,4cqi,3.5rem)] aspect-[21/9] min-h-48"
          roundedClass="rounded-[clamp(1rem,2cqi,1.75rem)]"
          fit={media?.fit} position={media?.position} data-field={field('image.alt')}
          priority
        />
)}
      </div>
    )
  }
</SectionShell>
