---
import type { Section } from '../definitions'
import Button from '../../atoms/Button.astro'
import { buttonLinkProps, buttonVariant } from '../../../lib/link-attrs'
import Typography from '../../atoms/Typography.astro'
import MediaFrame from '../../molecules/MediaFrame.astro'
import SectionHeader from '../../molecules/SectionHeader.astro'
import SectionShell from '../../molecules/SectionShell.astro'

interface Props {
  section: Extract<Section, { type: 'textImage' }>
  index: number
  motion?: boolean
}

const { section, index, motion = true } = Astro.props
const props = section.props
const field = (path: string) => `sections.${index}.props.${path}`
const reveal = section.motion ?? motion
const left = section.variant === 'left'
---

<SectionShell id={section.id} anchor={section.anchor} type={section.type} variant={section.variant} tone={section.tone} motion={reveal}>
  {
    section.variant !== 'wide' && (
      <div class="section-container grid items-center gap-12 @min-[760px]:grid-cols-2">
        {
          (props.eyebrow || props.heading || props.body || props.points.length > 0 || props.link) && (
          <div class:list={['flex flex-col items-start gap-6', left && '@min-[760px]:order-2']}>
            <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} field={field} />
            {props.body && <Typography as="p" size="body" color="muted" data-field={field('body')} markdown={props.body} />}
            {
              props.points.length > 0 && (
                <ul class="flex flex-col gap-3">
                  {props.points.map((point, pointIndex) => (
                    <li class="flex gap-3 text-[0.9375rem]">
                      <span class="text-accent" aria-hidden="true">
                        ✓
                      </span>
                      <span data-field={field(`points.${pointIndex}`)}>{point}</span>
                    </li>
                  ))}
                </ul>
              )
            }
            {
              props.link && (
                <Button {...buttonLinkProps(props.link)} variant={buttonVariant(props.link, 'secondary')} data-field={field('link.label')}>
                  {props.link.label}
                </Button>
              )
            }
          </div>
          )
        }
        {!props.image?.hidden && (
<MediaFrame
          src={props.image.src}
          alt={props.image.alt}
          aspectClass={left ? 'aspect-[4/4.6] @min-[760px]:order-1' : 'aspect-[4/4.6]'}
          fit={props.image?.fit} position={props.image?.position} data-field={field('image.alt')}
        />
)}
      </div>
    )
  }
  {
    section.variant === 'wide' && (
      <div class="section-container">
        {
          (props.eyebrow || props.heading || props.body || props.link) && (
          <div class="grid items-end gap-8 @min-[760px]:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
            <SectionHeader eyebrow={props.eyebrow} heading={props.heading} marks={props.marks} field={field} />
            {
              (props.body || props.link) && (
                <div class="flex flex-col items-start gap-5">
                  {props.body && <Typography as="p" size="lead" color="muted" data-field={field('body')} markdown={props.body} />}
                  {props.link && (
                    <Button {...buttonLinkProps(props.link)} variant={buttonVariant(props.link, 'text')} arrow data-field={field('link.label')}>
                      {props.link.label}
                    </Button>
                  )}
                </div>
              )
            }
          </div>
          )
        }
        {!props.image?.hidden && (
<MediaFrame src={props.image.src} alt={props.image.alt} aspectClass="mt-12 aspect-[16/7]" fit={props.image?.fit} position={props.image?.position} data-field={field('image.alt')} />
)}
        {
          props.points.length > 0 && (
            <ol class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(min(100%,14rem),1fr))] border-t border-[var(--line)]">
              {props.points.map((point, pointIndex) => (
                <li class="border-t border-[var(--line)] py-6 @min-[700px]:border-t-0 @min-[700px]:border-l @min-[700px]:px-6 @min-[700px]:first:border-l-0 @min-[700px]:first:pl-0">
                  <span class="font-mono text-[0.75rem] tracking-[0.08em] text-muted">{String(pointIndex + 1).padStart(2, '0')}</span>
                  <p class="mt-3 text-[0.9375rem] leading-[1.6]" data-field={field(`points.${pointIndex}`)}>
                    {point}
                  </p>
                </li>
              ))}
            </ol>
          )
        }
      </div>
    )
  }
</SectionShell>
