---
import { themeCss, type Page } from 'bearminion'
import type { Site } from '../components/organisms/site-definition'
import ConsentBanner from '../components/organisms/ConsentBanner.astro'
import Footer from '../components/organisms/Footer.astro'
import Header from '../components/organisms/Header.astro'
import Seo from '../components/seo/Seo.astro'
import { analyticsEnabled } from '../lib/analytics'
import { resolveLocalAsset } from '../lib/assets'
import { CONSENT_DEFAULT_SCRIPT, consentCopy, consentRequired } from '../lib/consent'
import '../styles/global.css'

interface Props {
  site: Site
  page: Page
}

const { site, page } = Astro.props
const icon = site.favicon ? resolveLocalAsset(site.favicon.src) : undefined
const ICON_TYPES: Record<string, string> = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp', gif: 'image/gif', avif: 'image/avif' }
const iconType = icon ? ICON_TYPES[icon.format] : undefined
const paletteCss = themeCss(site.theme.colors)
const themeColor = site.theme.mode === 'dark' ? '#1c1e24' : '#f7f8f8'
// Snippets ship in the live site's build only: not in `astro dev`, not in host previews. See lib/analytics.ts.
const analyticsOn = analyticsEnabled(process.env, import.meta.env.PROD)
const analytics = analyticsOn ? site.analytics : undefined
// With a banner, the snippets wait inside <template> until the visitor accepts. The banner itself shows in dev
// and previews too, so the owner sees it; only the live build has snippets to hold back. See lib/consent.ts.
const asks = consentRequired(site)
const gated = asks && analyticsOn
---

<!doctype html>
<html lang={site.lang ?? 'en'} data-theme={site.theme.mode} data-motion={site.theme.motion ? 'true' : 'false'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo site={site} page={page} pathname={Astro.url.pathname} />
    <meta name="theme-color" content={themeColor} />
    {gated && <script is:inline set:html={CONSENT_DEFAULT_SCRIPT} />}
    {analytics?.head && !asks && <Fragment set:html={analytics.head} />}
    {gated && analytics?.head && <template data-consent-snippet="head" set:html={analytics.head} />}
    {/* Always present so the editor can update the palette live. */}
    <style id="bm-theme" is:inline set:html={paletteCss}></style>
    {/* Without JavaScript the browser posts the contact form itself and comes back to #<id>-sent or #<id>-failed. */}
    <noscript>
      <style is:inline>
        [data-motion="true"] > [data-reveal] {
          opacity: 1;
          transform: none;
        }
        [data-contact-success]:target,
        [data-contact-failed]:target {
          display: block;
        }
        [data-contact]:has([data-contact-success]:target) [data-contact-form],
        [data-contact-reset] {
          display: none;
        }
      </style>
    </noscript>
    {icon && <link rel="icon" type={iconType} href={icon.src} />}
  </head>
  <body class="min-h-screen font-sans antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-bg"
    >
      Skip to content
    </a>
    <Header site={site} pathname={Astro.url.pathname} />
    <main id="content">
      <slot />
    </main>
    <Footer site={site} consentLabel={asks && site.consent?.reopen !== 'icon' ? consentCopy(site.consent).settings : undefined} />
    {analytics?.bodyEnd && !asks && <Fragment set:html={analytics.bodyEnd} />}
    {gated && analytics?.bodyEnd && <template data-consent-snippet="body" set:html={analytics.bodyEnd} />}
    {asks && <ConsentBanner consent={site.consent} />}
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const observer =
        reduce || !('IntersectionObserver' in window)
          ? null
          : new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue
                  entry.target.setAttribute('data-revealed', 'true')
                  observer?.unobserve(entry.target)
                }
              },
              { threshold: 0.1 },
            )
      function revealMotion() {
        document.querySelectorAll('[data-section-id][data-motion="true"]:not([data-revealed])').forEach((node) => {
          if (!observer) {
            node.setAttribute('data-revealed', 'true')
            return
          }
          observer.observe(node)
        })
      }
      revealMotion()
      document.addEventListener('bearminion:preview', revealMotion)
    </script>
  </body>
</html>
