---
import type { Site } from '../components/organisms/site-definition'
import type { Page } from '../components/sections/definitions'
import SectionList from '../components/sections/SectionList.astro'
import Base from '../layouts/Base.astro'
import { getPages, getSite } from '../lib/content'

export async function getStaticPaths() {
  const site = await getSite()
  // 404.json is rendered by src/pages/404.astro, so Astro emits /404.html instead of /404/index.html.
  const pages = await getPages(['404'])

  return pages.map((page) => ({
    params: {
      // The home page is stored as slug "index" and published at `/`.
      slug: page.slug === 'index' ? undefined : page.slug,
    },
    props: { site, page },
  }))
}

interface Props {
  site: Site
  page: Page
}

// The hosted editor draws the repository's current content (`Astro.locals.bearminion`); a static build uses the props.
const live = Astro.locals.bearminion
let { site, page } = Astro.props as Partial<Props>
if (live) {
  site = (await live.content.getSite()) as Site
  page = (await live.content.getPage(Astro.params.slug ?? 'index')) as Page | undefined
  if (!page) return Astro.rewrite('/404')
}
if (!site || !page) throw new Error(`No content for ${Astro.url.pathname}.`)
---

<Base site={site} page={page}>
  <SectionList sections={page.sections} motion={site.theme.motion} />
</Base>
