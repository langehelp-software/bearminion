{
  "name": "bearminion-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm build:lib && pnpm --parallel --filter bearminion --filter bearminion-site dev",
    "build": "pnpm build:lib && pnpm --filter bearminion-site build",
    "build:lib": "pnpm --filter bearminion build",
    "dev:lib": "pnpm --filter bearminion dev",
    "web:dev": "pnpm --filter @bearminion/web dev",
    "web:build": "pnpm build:lib && pnpm --filter @bearminion/web build",
    "docs:dev": "pnpm --filter @bearminion/docs dev",
    "docs:build": "pnpm --filter @bearminion/docs build",
    "test": "pnpm build:lib && pnpm -r --if-present test",
    "test:e2e": "pnpm build:lib && pnpm --filter @bearminion/tests test:e2e",
    "e2e:setup": "pnpm --filter @bearminion/tests exec playwright install chromium",
    "typecheck": "pnpm -r --if-present typecheck",
    "postinstall": "pnpm build:lib",
    "check-versions": "node scripts/check-versions.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm build:lib && node packages/editor/dist/registry-build.js record",
    "release": "pnpm build:lib && pnpm --filter create-bearminion build && node packages/editor/dist/registry-build.js check && BEARMINION_PREBUILT=1 changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "3.0.3"
  }
}
